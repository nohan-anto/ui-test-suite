JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
# Optional: token allowed to add comments + attachments, for `uitest publish` (set jira.publish.token: ${JIRA_WRITE_TOKEN})
JIRA_WRITE_TOKEN=
GITLAB_TOKEN=
# Show AI usage (tokens / cost / Copilot premium requests) in the terminal and reports: true | false
UITEST_SHOW_USAGE=true
